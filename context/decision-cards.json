      "id": "zbs-personal-value",
      "title": "收入回报看三件事：了解市场、打造产品、利用杠杆",
      "query_cues": [
        "个人价值公式",
        "个人价值",
        "了解市场",
        "打造产品",
        "利用杠杆",
        "升职",
        "加薪",
        "涨薪",
        "副业",
        "被低估",
        "市场价值",
        "值钱",
