    {
      "id": "outcome-over-proxy",
      "title": "沿着产出追到真实变化，再判断效率",
      "query_cues": [
        "fake work",
        "假工作",
        "忙了一天",
        "没有价值",
        "汇报材料",
        "向上管理",
        "工作没起色",
        "提效",
        "效率",
        "成果",
        "价值",
        "汇报",
        "绩效",
        "报告",
        "outcome",
        "productivity"
      ],
      "thesis": "动作、报告和速度可以是价值的代理信号，也可能取代价值本身。评估 AI 提效，要追问产出之后改变了哪个决定或用户结果，而不只数产出和节省的时间。",
      "conditions": [
        "结果常常有延迟、难归因，不能用立即变现作为所有工作的唯一验收。",
        "组织激励可能奖励代理信号，个人能先闭合一个小的判断—交付—反馈循环。",
        "停做测试只适合低风险、可恢复的工作，并先写下预期后果。"
      ],
      "does_not_imply": [
        "报告、沟通、合规、关系和管理不天然是假工作。",
        "不要把一个岗位或做这份工作的人判为假的。"
      ],
      "diagnostic_questions": [
        "这份产出完成后，下游会作出什么不同的决定或行动？",
        "若多生产十份，真实结果会更近吗？"
      ],
