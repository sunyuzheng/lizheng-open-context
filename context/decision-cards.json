    {
      "id": "advice-with-conditions",
      "title": "先检查问题中的诊断，再迁移建议",
      "query_cues": [
        "好建议",
        "用不上",
        "执行不动",
        "执行力不行",
        "怎么提问",
        "问问题",
        "照搬",
        "卡点",
        "建议",
        "提问",
        "处境",
        "目标",
        "阻力",
        "advice",
        "question"
      ],
      "thesis": "提问通常已经包含对卡点的解释。借鉴建议时，既要检查这个解释，也要带走原选择成立的条件、历史积累和未采取的替代方案。",
      "conditions": [
        "把已发生的事实和自己的解释分开，不把用户的初步诊断当已证实事实。",
        "背景只补充会实质改变答案的信息，不要求用户先填完整问卷。",
        "认同却做不到时，讨论具体停在哪一步与可缩小的尝试，而不是给人格下结论。"
      ],
      "does_not_imply": [
        "不能用立正自己的业务条件替所有人决定接不接商单。",
        "不能把行动阻力一概归为懒惰、恐惧或心理疾病。"
      ],
      "diagnostic_questions": [
        "哪些事实让你把卡点理解成了这里？",
        "这个建议需要的条件，哪些在你的处境中存在，哪些缺少？"
      ],
