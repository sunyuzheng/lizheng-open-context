      "id": "youtube-YxJntEwMUfk#cue-3",
      "speaker_id": "unknown",
      "speaker_name": "",
      "speaker_status": "unresolved",
      "start_seconds": 8.479,
      "text": "学校就是在不断的去告诉你什么是好的什么是"
