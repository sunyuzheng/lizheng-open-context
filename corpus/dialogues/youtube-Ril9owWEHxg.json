      "end_seconds": 33.039,
      "id": "youtube-Ril9owWEHxg#cue-8",
      "speaker_id": "unknown",
      "speaker_name": "",
      "speaker_status": "unresolved",
      "start_seconds": 29.48,
      "text": "然后咱们就从这一段经历先讲起,"
