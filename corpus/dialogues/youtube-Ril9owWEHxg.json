      "end_seconds": 44.439,
      "id": "youtube-Ril9owWEHxg#cue-11",
      "speaker_id": "unknown",
      "speaker_name": "",
      "speaker_status": "unresolved",
      "start_seconds": 40.64,
      "text": "对,我是大学其实是四年,"
