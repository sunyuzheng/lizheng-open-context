    {
      "end_seconds": 40.64,
      "id": "youtube-Ril9owWEHxg#cue-10",
      "speaker_id": "unknown",
      "speaker_name": "",
      "speaker_status": "unresolved",
      "start_seconds": 37.2,
      "text": "然后包括你在那里上学的经历之类的。"
    },
