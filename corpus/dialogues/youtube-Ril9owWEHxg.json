    {
      "end_seconds": 48.32,
      "id": "youtube-Ril9owWEHxg#cue-12",
      "speaker_id": "unknown",
      "speaker_name": "",
      "speaker_status": "unresolved",
      "start_seconds": 44.439,
      "text": "然后我中间是GAP一年再回国做了一些实习,"
    },
    {
      "end_seconds": 52.92,
      "id": "youtube-Ril9owWEHxg#cue-13",
      "speaker_id": "unknown",
      "speaker_name": "",
      "speaker_status": "unresolved",
      "start_seconds": 48.32,
      "text": "然后我本科是学Psychology还有Media Studies在Berkeley,"
    },
