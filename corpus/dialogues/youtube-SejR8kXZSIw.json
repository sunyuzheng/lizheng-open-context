      "id": "cue-21",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 36.32,
      "text": "就是我的大脑\n就是里边的想法"
