    {
      "end_seconds": 4.16,
      "id": "cue-2",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 2.08,
      "text": "或者其他人的\n中英夹杂的话"
