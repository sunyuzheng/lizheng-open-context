      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 52.88,
      "text": "又把这个想法\n给表达清楚的情况下"
