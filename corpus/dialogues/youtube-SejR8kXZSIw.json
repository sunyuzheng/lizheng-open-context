    {
      "end_seconds": 64.0,
      "id": "cue-36",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 63.04,
      "text": "把这件事儿做好了"
