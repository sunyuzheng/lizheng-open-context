      "end_seconds": 30.96,
      "id": "cue-17",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 30.08,
      "text": "然后我跟他说啊"
    },
    {
      "end_seconds": 34.0,
      "id": "cue-18",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 31.04,
      "text": "就是我其实已经\n尽我的所能"
