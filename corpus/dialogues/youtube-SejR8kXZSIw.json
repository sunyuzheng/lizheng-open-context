      "id": "cue-35",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 60.8,
      "text": "所以说\n我努力的试图"
