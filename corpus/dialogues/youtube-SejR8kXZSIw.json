    {
      "end_seconds": 17.6,
      "id": "cue-9",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 16.0,
      "text": "就是我今天\n在我的频道上"
    },
    {
      "end_seconds": 19.68,
      "id": "cue-10",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 17.6,
      "text": "看到这样一个呃留言啊"
    },
    {
      "end_seconds": 20.72,
      "id": "cue-11",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 19.68,
      "text": "就是他留言的很诚恳"
    },
    {
      "end_seconds": 22.64,
      "id": "cue-12",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 20.8,
      "text": "他说我的中英夹杂"
    },
    {
      "end_seconds": 24.72,
      "id": "cue-13",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 22.88,
      "text": "导致他\n看我视频的时候呢"
    },
    {
      "end_seconds": 26.16,
      "id": "cue-14",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 24.72,
      "text": "他都要去查这些意思"
