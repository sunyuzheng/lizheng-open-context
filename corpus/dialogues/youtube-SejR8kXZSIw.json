    {
      "end_seconds": 36.32,
      "id": "cue-20",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 35.52,
      "text": "但是没办法"
