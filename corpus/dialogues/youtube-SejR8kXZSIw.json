    {
      "end_seconds": 15.92,
      "id": "cue-8",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 15.28,
      "text": "什么意思呢"
