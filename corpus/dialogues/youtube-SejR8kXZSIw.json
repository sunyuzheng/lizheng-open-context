    {
      "end_seconds": 39.12,
      "id": "cue-22",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 38.4,
      "text": "这是一个想法"
