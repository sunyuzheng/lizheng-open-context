      "end_seconds": 35.12,
      "id": "cue-19",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 34.24,
      "text": "不中英夹杂了"
