    {
      "end_seconds": 27.92,
      "id": "cue-15",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 26.56,
      "text": "然后他觉得\n看的不是很流畅"
    },
    {
      "end_seconds": 29.52,
      "id": "cue-16",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 28.0,
      "text": "产生了深深的挫败感"
