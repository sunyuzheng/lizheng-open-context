    {
      "end_seconds": 5.92,
      "id": "cue-3",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 4.48,
      "text": "我试着这样解释一下"
    },
    {
      "end_seconds": 8.0,
      "id": "cue-4",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 6.0,
      "text": "看看你的感官\n会不会好一点"
    },
    {
      "end_seconds": 11.04,
      "id": "cue-5",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 8.56,
      "text": "就是我之所以\n中英夹杂"
    },
    {
      "end_seconds": 12.8,
      "id": "cue-6",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 11.52,
      "text": "是我的能力有限"
    },
    {
      "end_seconds": 14.64,
      "id": "cue-7",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 13.2,
      "text": "不是你的能力有限"
