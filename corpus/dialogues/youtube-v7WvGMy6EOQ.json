  "units": [
    {
      "end_seconds": 2.32,
      "id": "cue-1",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 1.04,
      "text": "轮回到底存不存在"
    },
    {
      "end_seconds": 3.92,
      "id": "cue-2",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 2.4,
      "text": "前生今世\n到底存不存在"
    },
    {
      "end_seconds": 5.36,
      "id": "cue-3",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 4.24,
      "text": "我觉得一定是存在的"
    },
    {
      "end_seconds": 6.96,
      "id": "cue-4",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 5.6,
      "text": "但是不是\n像大家想的那样"
    },
    {
      "end_seconds": 10.8,
      "id": "cue-5",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 6.96,
      "text": "所谓的我上辈子\n是我上一世为人"
    },
    {
      "end_seconds": 12.64,
      "id": "cue-6",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 10.88,
      "text": "然后这辈子\n是我这一世为人"
    },
    {
      "end_seconds": 15.36,
      "id": "cue-7",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 13.12,
      "text": "其实轮回前生今世"
    },
    {
      "end_seconds": 19.36,
      "id": "cue-8",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 15.6,
      "text": "就是我的过去\n未来和现在"
    },
    {
      "end_seconds": 21.76,
      "id": "cue-9",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 19.68,
      "text": "那今世就是这个当下"
    },
    {
      "end_seconds": 22.72,
      "id": "cue-10",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 21.84,
      "text": "就是现在"
    },
    {
      "end_seconds": 24.32,
      "id": "cue-11",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 23.12,
      "text": "然后这个现在就"
    },
    {
      "end_seconds": 26.88,
      "id": "cue-12",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 25.12,
      "text": "你可以在时间上\n是无穷小对吧"
    },
    {
      "end_seconds": 28.72,
      "id": "cue-13",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 27.12,
      "text": "其实是没有一段\n直接的时间的"
    },
    {
      "end_seconds": 31.36,
      "id": "cue-14",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 29.04,
      "text": "但是总之就是\n我正在发生的"
    },
    {
      "end_seconds": 33.68,
      "id": "cue-15",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 31.36,
      "text": "这个being的\n这那么一刻"
    },
    {
      "end_seconds": 34.8,
      "id": "cue-16",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 34.08,
      "text": "它是现在"
    },
    {
      "end_seconds": 36.72,
      "id": "cue-17",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 35.28,
      "text": "那在之前都是过去"
    },
    {
      "end_seconds": 38.0,
      "id": "cue-18",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 36.96,
      "text": "在之后都是未来"
    },
    {
      "end_seconds": 39.92,
      "id": "cue-19",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 38.56,
      "text": "如果从这个角度\n去理解的话"
    },
    {
      "end_seconds": 41.76,
      "id": "cue-20",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 39.92,
      "text": "就可以想清楚\n很多事情啊"
    },
    {
      "end_seconds": 44.96,
      "id": "cue-21",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 42.08,
      "text": "就是首先\n我们的过去和现在的"
    },
    {
      "end_seconds": 46.0,
      "id": "cue-22",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 45.04,
      "text": "这个关系是什么"
    },
    {
      "end_seconds": 48.8,
      "id": "cue-23",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 46.48,
      "text": "我现在说的话\n是很大程度上"
    },
    {
      "end_seconds": 50.8,
      "id": "cue-24",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 48.8,
      "text": "或者说百分之\n九十九点九九九九九"
    },
    {
      "end_seconds": 51.84,
      "id": "cue-25",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 50.96,
      "text": "甚至是百分之百"
    },
    {
      "end_seconds": 53.04,
      "id": "cue-26",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 51.84,
      "text": "是由过去决定的对吧"
    },
    {
      "end_seconds": 54.88,
      "id": "cue-27",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 53.6,
      "text": "那我怎么样子去"
    },
    {
      "end_seconds": 57.68,
      "id": "cue-28",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 55.68,
      "text": "就是今生有一个\n不一样的"
    },
    {
      "end_seconds": 60.24,
      "id": "cue-29",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 58.32,
      "text": "这样的一个\n打破轮回啊"
    },
    {
      "end_seconds": 62.4,
      "id": "cue-30",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 60.56,
      "text": "或者说是\n我去做善事啊"
    },
    {
      "end_seconds": 66.4,
      "id": "cue-31",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 62.8,
      "text": "那就是我去摆脱\n这样的一个惯性的影响"
    },
    {
      "end_seconds": 70.48,
      "id": "cue-32",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 66.96,
      "text": "比如说我现在\n突然一下子领悟了"
    },
    {
      "end_seconds": 72.24,
      "id": "cue-33",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 70.64,
      "text": "我原来不存钱\n我现在存钱了"
    },
    {
      "end_seconds": 73.92,
      "id": "cue-34",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 72.48,
      "text": "我原来不健身\n我现在健身了"
    },
    {
      "end_seconds": 75.44,
      "id": "cue-35",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 74.24,
      "text": "然后我原来不干好事儿"
    },
    {
      "end_seconds": 76.32,
      "id": "cue-36",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 75.44,
      "text": "我现在干好事儿了"
    },
    {
      "end_seconds": 77.68,
      "id": "cue-37",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 76.64,
      "text": "那他就是放下屠刀"
    },
    {
      "end_seconds": 78.48,
      "id": "cue-38",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 77.76,
      "text": "立地成佛对吧"
    },
    {
      "end_seconds": 80.08,
      "id": "cue-39",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 78.8,
      "text": "那你就是在今世"
    },
    {
      "end_seconds": 82.08,
      "id": "cue-40",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 80.16,
      "text": "就是在现在的这当下"
    },
    {
      "end_seconds": 84.0,
      "id": "cue-41",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 82.4,
      "text": "你得到了那样一个"
    },
    {
      "end_seconds": 85.76,
      "id": "cue-42",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 84.16,
      "text": "和之前完全不一样的\n命运"
    },
    {
      "end_seconds": 88.88,
      "id": "cue-43",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 86.08,
      "text": "那你就摆脱了\n轮回给你的这个宿命"
    },
    {
      "end_seconds": 90.64,
      "id": "cue-44",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 89.12,
      "text": "然后你得到了一个\n新的宿命"
    },
    {
      "end_seconds": 92.16,
      "id": "cue-45",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 90.96,
