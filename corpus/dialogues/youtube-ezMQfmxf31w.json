      "id": "youtube-ezMQfmxf31w#cue-24",
      "speaker_id": "unknown",
      "speaker_name": "",
      "speaker_status": "unresolved",
      "start_seconds": 77.354,
      "text": "讨厌我他一看觉得这人怎么这么说还有一个"
