      "end_seconds": 72.159,
      "id": "youtube-ezMQfmxf31w#cue-21",
      "speaker_id": "unknown",
      "speaker_name": "",
      "speaker_status": "unresolved",
      "start_seconds": 69.2,
      "text": "永远不要相信员工你能分辨出来是真是假吗"
