    {
      "end_seconds": 103.759,
      "id": "youtube-ezMQfmxf31w#cue-30",
      "speaker_id": "unknown",
      "speaker_name": "",
      "speaker_status": "unresolved",
      "start_seconds": 99.76,
      "text": "为了卖书就是为了卖那些所以只能靠法律了"
