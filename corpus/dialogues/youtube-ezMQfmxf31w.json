      "end_seconds": 114.439,
      "id": "youtube-ezMQfmxf31w#cue-33",
      "speaker_id": "unknown",
      "speaker_name": "",
      "speaker_status": "unresolved",
      "start_seconds": 111.011,
      "text": "怕这个吗是消费者是没有动力去认真分辨"
