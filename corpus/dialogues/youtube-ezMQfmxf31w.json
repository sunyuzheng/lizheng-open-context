    {
      "end_seconds": 111.011,
      "id": "youtube-ezMQfmxf31w#cue-32",
      "speaker_id": "unknown",
      "speaker_name": "",
      "speaker_status": "unresolved",
      "start_seconds": 107.359,
      "text": "不管用他都会打帆书人家都侵你的权了人家还"
