    {
      "end_seconds": 105.879,
      "id": "youtube-ezMQfmxf31w#cue-31",
      "speaker_id": "unknown",
      "speaker_name": "",
      "speaker_status": "unresolved",
      "start_seconds": 103.759,
      "text": "打官司以及认准帆书出品"
