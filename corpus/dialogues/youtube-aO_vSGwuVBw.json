      "end_seconds": 93.333,
      "id": "cue-60",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 91.433,
      "text": "我们很多人嘴\n上说着范式革命"
    },
    {
      "end_seconds": 93.933,
      "id": "cue-61",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 93.333,
      "text": "范式革命"
    },
