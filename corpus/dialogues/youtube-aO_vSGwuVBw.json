    {
      "end_seconds": 82.3,
      "id": "cue-53",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 81.6,
      "text": "见到了两个"
    },
    {
      "end_seconds": 83.633,
      "id": "cue-54",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 82.3,
      "text": "revolutionary\ntechnology"
    },
    {
      "end_seconds": 84.5,
      "id": "cue-55",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 83.833,
      "text": "第二个是AI"
