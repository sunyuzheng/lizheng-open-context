      "end_seconds": 50.833,
      "id": "cue-33",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 49.533,
      "text": "苏格拉底\n的教学方式"
