    {
      "end_seconds": 59.3,
      "id": "cue-38",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 58.7,
      "text": "这样的时候"
