      "id": "cue-37",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 56.1,
      "text": "引导别人自己\n去得到那个答案"
