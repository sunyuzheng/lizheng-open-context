      "id": "cue-56",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "question",
      "start_seconds": 84.7,
      "text": "第一个是什么？"
    },
