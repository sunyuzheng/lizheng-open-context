    {
      "end_seconds": 38.767,
      "id": "cue-26",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 37.667,
      "text": "所以说我们\n一拍即合"
