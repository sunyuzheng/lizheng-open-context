      "id": "cue-13",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 18.733,
      "text": "那我在教\nAI的时候"
