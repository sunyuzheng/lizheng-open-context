      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "question",
      "start_seconds": 20.867,
      "text": "学生们靠意志力\n去学习，对吧？"
