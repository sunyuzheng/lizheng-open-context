    {
      "end_seconds": 60.367,
      "id": "cue-39",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 59.3,
      "text": "它的效果\n才是好的"
