      "id": "cue-45",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 69.833,
      "text": "比如说我很喜\n欢的一个例子"
