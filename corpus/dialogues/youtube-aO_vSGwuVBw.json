      "id": "cue-24",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 34.7,
      "text": "他觉得我们\n的教育系统"
