      "end_seconds": 79.5,
      "id": "cue-51",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 78.7,
      "text": "开篇第一句话"
