      "id": "cue-58",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 87.767,
      "text": "大家对AI范\n式的理解"
    },
    {
      "end_seconds": 91.2,
      "id": "cue-59",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 90.233,
      "text": "但是马上又发现"
