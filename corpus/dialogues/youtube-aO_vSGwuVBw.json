      "end_seconds": 61.733,
      "id": "cue-40",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 60.467,
      "text": "所以说我们\n在教学的时候呢"
