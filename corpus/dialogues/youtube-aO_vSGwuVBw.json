    {
      "end_seconds": 56.1,
      "id": "cue-36",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 54.8,
      "text": "他是通过\n不断的提问"
