      "id": "cue-5",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 6.867,
      "text": "我应该是很\n会学习才对"
