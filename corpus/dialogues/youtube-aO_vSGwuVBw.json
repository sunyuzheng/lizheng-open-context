    {
      "end_seconds": 81.467,
      "id": "cue-52",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 79.5,
      "text": "就是他在七十\n岁的人生里边"
