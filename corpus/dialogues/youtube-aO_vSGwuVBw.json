      "id": "cue-28",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 40.867,
      "text": "就采取了完全不\n一样的教学方法"
