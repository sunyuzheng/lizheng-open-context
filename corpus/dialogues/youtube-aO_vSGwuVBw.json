      "id": "cue-50",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 77.267,
      "text": "这是他在\n《Age of AI》的"
