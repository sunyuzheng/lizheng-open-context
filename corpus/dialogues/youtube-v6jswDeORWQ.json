      "id": "cue-8",
      "speaker_id": "yuzheng",
      "speaker_name": "立正",
      "speaker_status": "reviewed-source-attribution",
      "speech_act": "statement",
      "start_seconds": 14.76,
      "text": "如果你睡觉睡得好，\n精神饱满去健身的话"
